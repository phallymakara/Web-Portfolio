# =============================================================================
# WEB PORTFOLIO ENVIRONMENT VARIABLES (TEMPLATE)
# =============================================================================
# Copy this file to .env and replace with your actual keys.
# DO NOT commit .env with real credentials into source control.

# 1. Web3Forms Access Key (Form-to-Email Service -> Delivers directly to your inbox)
# Get a free key at: https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# 2. Telegram Bot Notifications (Instant alerts to your Telegram app)
# Step 1: Open Telegram, search @BotFather, send /newbot to obtain BOT_TOKEN
# Step 2: Search @userinfobot or @getidsbot to get your numeric CHAT_ID
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 3. Optional: Contact Email override (defaults to profile.email)
# VITE_CONTACT_EMAIL=your_email@example.com

# Note for Serverless Deployment (Vercel / Netlify):
# On serverless platforms, define TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID in the
# platform dashboard environment settings. The /api/contact handler will read them
# securely server-side without bundling them into the client-side JavaScript.
